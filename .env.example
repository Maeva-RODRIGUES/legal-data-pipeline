JUDILIBRE_API_KEY=your-api-key
DATABASE_URL=postgresql://legal:legal@127.0.0.1:5432/legal
ELASTICSEARCH_URL=http://127.0.0.1:9200
# URL stable de la ressource JSON open data de l'Autorité de la concurrence sur data.gouv.fr :
# elle redirige vers le dernier fichier publié. Téléchargée la nuit du lundi par le pipeline Celery.
# Vide : l'étape open data échoue (non bloquante).
ADLC_OPENDATA_URL=https://www.data.gouv.fr/api/1/datasets/r/be23f793-a37b-4613-8a80-c6b4116058fb
# Mot de passe du rôle PostgreSQL grafana_reader (lecture seule), lu par postgres et grafana. Obligatoire pour compose up.
GRAFANA_DB_PASSWORD=
# Mot de passe de l'utilisateur admin de Grafana (http://127.0.0.1:3000), appliqué à la création du volume grafana-data.
GRAFANA_ADMIN_PASSWORD=
