    {
      "id": 3,
      "type": "table",
      "title": "Runs de collecte",
      "description": "Tous les runs de collecte de la période, échecs compris (compteurs partiels). Du / Au : fenêtre demandée (Judilibre) ou date du run.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "legal-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "legal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run_id AS \"Run\",\n                   source AS \"Source\",\n                   started_at AS \"Début\",\n                   date_type AS \"Type de date\",\n                   to_char(date_start, 'DD/MM/YYYY') AS \"Du\",\n                   to_char(date_end, 'DD/MM/YYYY') AS \"Au\",\n                   status AS \"Statut\",\n                   extract(epoch FROM finished_at - started_at) AS \"Durée\",\n                   nb_fetched AS \"Lues\",\n                   nb_new AS \"Nouvelles\",\n                   nb_changed AS \"Modifiées\",\n                   error AS \"Erreur\"\n            FROM bronze.collection_runs\n            WHERE source IN ($source)\n              AND $__timeFilter(started_at)\n            ORDER BY run_id DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Durée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "noValue",
                "value": "en cours"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0,
                        "text": "success"
                      },
                      "failed": {
                        "color": "red",
                        "index": 1,
                        "text": "failed"
                      },
                      "running": {
