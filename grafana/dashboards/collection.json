    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Décisions nouvelles et modifiées, toutes sources",
      "description": "Activité réelle de la collecte : nouvelles et modifiées, empilées par source, invisibles à côté des volumes lus.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "legal-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "legal-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS time,\n                   source AS metric,\n                   nb_new + nb_changed AS value\n            FROM bronze.collection_runs\n            WHERE source IN ($source)\n              AND status <> 'running'\n              AND $__timeFilter(started_at)\n            ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
