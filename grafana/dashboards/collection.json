  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Collecte : $source",
      "description": "Décisions lues, nouvelles et modifiées à chaque run de la source (bronze.collection_runs). Un panneau par source : les volumes lus diffèrent trop (open data complet, fenêtre Judilibre, première page du site). Pour le scraper, « nouvelles » compte les décisions nouvelles dans son Bronze, pas les écarts avec l'open data (contrôle site_decisions_missing_from_opendata).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "legal-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "legal-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS time,\n                   nb_fetched AS \"lues\",\n                   nb_new AS \"nouvelles\",\n                   nb_changed AS \"modifiées\"\n            FROM bronze.collection_runs\n            WHERE source = '$source'\n              AND status <> 'running'\n              AND $__timeFilter(started_at)\n            ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lues"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
